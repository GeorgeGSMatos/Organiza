<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF><UseWindowsForms>true</UseWindowsForms><EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings><PlatformTarget>x64</PlatformTarget>
    <AssemblyName>Organiza</AssemblyName><RootNamespace>Organiza.Wpf</RootNamespace>
    <Version>0.8.0</Version><ApplicationIcon>Assets/Organiza.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <Using Remove="System.Windows.Forms" /><Using Remove="System.Drawing" />
    <Content Include="../AUTHORS.md;../LICENSE.txt;../EULA.txt;../NOTICE.md" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Resource Include="Assets/Organiza.ico" />
    <Compile Remove="Checks/**/*.cs" /><Page Remove="Checks/**/*.xaml" />
    <Content Include="../src/main/*.cjs" Exclude="../src/main/main.cjs;../src/main/preload.cjs" Link="engine/main/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../src/engine/*.cjs" Link="engine/engine/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../src/native/*" Link="engine/native/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="runtime/*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
